# ---- Server
PORT=3000
# Public HTTPS URL of this server (e.g. from `ngrok http 3000` or `cloudflared tunnel`)
PUBLIC_BASE_URL=https://your-tunnel.ngrok-free.app
DATA_FILE=data/db.json
ESCROW_FEE_BPS=100

# ---- WhatsApp Cloud API (developers.facebook.com → your app → WhatsApp → API Setup)
# console = log messages locally, cloud = send real WhatsApp messages
WHATSAPP_MODE=console
WHATSAPP_API_VERSION=v21.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Bot's number, digits only, for wa.me share links
WHATSAPP_BOT_NUMBER=15550000000
WHATSAPP_VERIFY_TOKEN=settle-dev-verify
# App Secret (App settings → Basic). Enables X-Hub-Signature-256 checks.
WHATSAPP_APP_SECRET=
# Flow IDs after uploading flows/pin_flow.json and flows/set_pin_flow.json in WhatsApp Manager.
# Leave empty to fall back to "reply with your PIN" in chat.
WHATSAPP_PIN_FLOW_ID=
WHATSAPP_SET_PIN_FLOW_ID=
WHATSAPP_FLOW_MODE=draft

# ---- Busha Business (mock = no credentials needed, live = real sandbox/production API)
BUSHA_MODE=mock
BUSHA_BASE_URL=https://api.sandbox.busha.so
BUSHA_SECRET_KEY=
BUSHA_PUBLIC_KEY=
BUSHA_WEBHOOK_SECRET=mock-webhook-secret
BUSHA_CRYPTO_NETWORK=TRX

# ---- Claude (optional): understands free-text / Pidgin messages. Without it, a rules parser is used.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
